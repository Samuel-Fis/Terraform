# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Exception: keep example variable files
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config
.terraformrc
terraform.rc

# Sensitive local files
*.secret
*.secrets

# Editor / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
